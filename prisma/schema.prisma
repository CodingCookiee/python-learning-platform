// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  LEARNER
  AUTHOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  progress      Progress[]
  achievements  UserAchievement[]
  streak        Streak?

  xp            Int       @default(0)
  level         Int       @default(1)
  role          Role      @default(LEARNER)

  /// First-run setup (/onboarding): set once the learner has answered it
  onboardedAt   DateTime?
  /// new | other-language | python
  experience    String?
  /// python | automation
  goal          String?
  /// The weekly training target the dashboard plans around
  weeklyHours   Int       @default(10)

  exerciseSubmissions ExerciseSubmission[]
  projectSubmissions  ProjectSubmission[]
  checkpointAttempts  CheckpointAttempt[]
  reviewItems         ReviewItem[]
  aiCredential        AiCredential?
  llmUsage            LlmUsage[]
  labRuns             LabRun[]
  drillDrafts         DrillDraft[]
  learningLog         LearningLogEntry[]
  ciLinks             CiLink[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// A course, e.g. Python (kyu grades) or AI Automation (dan grades). Synced from content/.
model Track {
  id         String    @id @default(cuid())
  slug       String    @unique
  title      String
  summary    String
  /// "kyu" or "dan": how modules in this track map to grades
  grade      String
  order      Int       @unique
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  modules Module[]

  @@map("tracks")
}

model Module {
  id          String    @id @default(cuid())
  /// Stable identity from content/ (null only for pre-content legacy rows)
  slug        String?   @unique
  trackId     String?
  title       String
  summary     String    @default("")
  description String
  outcomes    String[]  @default([])
  phase       String
  /// Position within the track
  order       Int
  duration    Int
  /// Set when the module disappears from content/; learner history stays
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  track       Track?    @relation(fields: [trackId], references: [id])
  /// Checkpoint (module exam): how many drills an attempt draws, the pass mark, and an
  /// optional explicit pool of drill slugs (default: the module's core and stretch drills)
  checkpointPick     Int      @default(6)
  checkpointPassMark Float    @default(0.8)
  checkpointPool     String[] @default([])

  lessons            Lesson[]
  projects           Project[]
  checkpointAttempts CheckpointAttempt[]

  prerequisites Module[] @relation("ModulePrerequisites")
  dependents    Module[] @relation("ModulePrerequisites")

  @@unique([trackId, order])
  @@map("modules")
}

model Lesson {
  id            String   @id @default(cuid())
  slug          String?  @unique
  archivedAt    DateTime?
  moduleId      String
  title         String
  description   String
  content       String   @db.Text
  order         Int
  estimatedTime Int
  /// The lesson's local lab and how it's verified (lab: in the lesson's frontmatter), if any
  lab           Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  module        Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  exercises     Exercise[]
  progress      Progress[]
  labRuns       LabRun[]

  @@unique([moduleId, order])
  @@map("lessons")
}

model Exercise {
  id            String   @id @default(cuid())
  slug          String?  @unique
  lessonId      String
  title         String
  description   String
  /// The prompt, in markdown
  instructions  String   @db.Text
  starterCode   String   @db.Text
  solution      String   @db.Text
  /// JSON [{ name, hidden }]: the test list shown before the first run
  testCases     String   @db.Text
  /// The drill's plp tests.py source
  tests         String   @db.Text @default("")
  /// function | program | predict | fix | refactor
  type          String   @default("function")
  hints         String   @db.Text
  /// warm-up | core | stretch
  difficulty    String
  tags          String[] @default([])
  packages      String[] @default([])
  timeoutMs     Int      @default(5000)
  /// False for script-style drills (programs, tests, script: true): the code runs, it isn't imported
  importSolution Boolean  @default(true)
  /// Multi-file drills: [{ path, editable, starter, solution }] for the learner's other files
  files         Json?
  /// The main file's name (solution.py for single-file drills, main.py by default for multi-file)
  mainFile      String   @default("solution.py")
  /// Required drills gate lesson completion; optional ones are extra practice
  required      Boolean  @default(true)
  archivedAt    DateTime?
  order         Int
  xpReward      Int      @default(25)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lesson        Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions   ExerciseSubmission[]
  reviewItems   ReviewItem[]
  drafts        DrillDraft[]

  @@unique([lessonId, order])
  @@map("exercises")
}

model Project {
  id              String   @id @default(cuid())
  slug            String?  @unique
  archivedAt      DateTime?
  moduleId        String
  title           String
  summary         String   @default("")
  /// The brief, in markdown
  description     String
  requirements    String   @db.Text
  successCriteria String   @db.Text
  starterTemplate String?  @db.Text
  /// Acceptance tests run by GitHub Actions in the learner's repo: { files: {path: source}, requirements: [...] }
  acceptance      Json?
  estimatedTime   Int
  xpReward        Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  module          Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions     ProjectSubmission[]

  @@map("projects")
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("progress")
}

model ExerciseSubmission {
  id          String   @id @default(cuid())
  userId      String
  exerciseId  String
  code        String   @db.Text
  passed      Boolean
  testResults String   @db.Text
  hintsUsed   Int      @default(0)
  attempts    Int      @default(1)
  /// practice (the drill page), review (spaced repetition) or checkpoint (module exam)
  mode        String   @default("practice")
  checkpointAttemptId String?
  submittedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId])
  @@map("exercise_submissions")
}

/// One sitting of a module's checkpoint: the drills it drew, which passed, and the score
model CheckpointAttempt {
  id          String    @id @default(cuid())
  userId      String
  moduleId    String
  exerciseIds String[]
  passedIds   String[]  @default([])
  /// Taken to test out of the module before doing its lessons
  placement   Boolean   @default(false)
  score       Float?
  passed      Boolean   @default(false)
  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([userId, moduleId])
  @@map("checkpoint_attempts")
}

/// Spaced review of a passed drill: it comes back with a blank editor when due
model ReviewItem {
  id             String    @id @default(cuid())
  userId         String
  exerciseId     String
  /// Index into the review intervals (1, 3, 7, 21, 60, 120 days)
  stage          Int       @default(0)
  dueAt          DateTime
  lapses         Int       @default(0)
  reviews        Int       @default(0)
  lastReviewedAt DateTime?
  createdAt      DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([userId, exerciseId])
  @@index([userId, dueAt])
  @@map("review_items")
}

model ProjectSubmission {
  id          String   @id @default(cuid())
  userId      String
  projectId   String
  files       String   @db.Text
  status      String
  feedback    String?  @db.Text
  /// A rubric review by the learner's own AI key (lib/ai/reviewer.ts); the examiner still decides
  aiReview     Json?
  aiReviewedAt DateTime?
  submittedAt DateTime @default(now())
  evaluatedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, projectId])
  @@map("project_submissions")
}

model Achievement {
  id          String   @id @default(cuid())
  slug        String?  @unique
  archivedAt  DateTime?
  order       Int      @default(0)
  name        String   @unique
  description String
  icon        String
  category    String
  criteria    String   @db.Text
  xpReward    Int      @default(0)
  tier        String
  createdAt   DateTime @default(now())

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Streak {
  id               String   @id @default(cuid())
  userId           String   @unique
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastActivityDate DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}

/// The learner's own AI provider key (BYOK). The key is AES-256-GCM encrypted with
/// ENCRYPTION_KEY, bound to the user id, and never sent back to the browser.
model AiCredential {
  id           String   @id @default(cuid())
  userId       String   @unique
  /// anthropic | openai
  provider     String
  model        String
  encryptedKey String   @db.Text
  /// Last four characters, to recognise the key in Settings
  keyHint      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_credentials")
}

/// One AI call: who, what for, which model, and the tokens it took
model LlmUsage {
  id           String   @id @default(cuid())
  userId       String
  /// tutor | explain | test | review
  feature      String
  provider     String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  cachedTokens Int      @default(0)
  exerciseId   String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("llm_usage")
}

/// A learner's attempt at a lesson's local lab. For webhook labs, token is the
/// secret part of their personal URL; verifiedAt is set once a check passes.
model LabRun {
  id            String    @id @default(cuid())
  userId        String
  lessonId      String
  token         String    @unique
  verifiedAt    DateTime?
  /// What the last check saw (a webhook body, a probed response, pasted output), trimmed
  lastPayload   String?   @db.Text
  lastResult    String?   @db.Text
  lastCheckedAt DateTime?
  checks        Int       @default(0)
  createdAt     DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("lab_runs")
}

/// The learner's in-progress code for a drill (practice mode), autosaved so it follows them across devices
model DrillDraft {
  userId     String
  exerciseId String
  code       String   @db.Text
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([userId, exerciseId])
  @@map("drill_drafts")
}

/// One week of the learning log: the roadmap's weekly check-in, pre-filled from activity and edited by the learner
model LearningLogEntry {
  id        String   @id @default(cuid())
  userId    String
  /// Monday 00:00 of the week (server time)
  weekOf    DateTime
  /// Where the learner was in the course when they wrote it
  phase     String   @default("")
  hours     Float    @default(0)
  built     String   @db.Text @default("")
  learned   String   @db.Text @default("")
  stuck     String   @db.Text @default("")
  nextGoal  String   @db.Text @default("")
  question  String   @db.Text @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekOf])
  @@map("learning_log")
}

/// A learner's GitHub repo connected to a capstone's acceptance tests or a lab's checks.
/// Their pylearn.yml workflow fetches the tests and reports back with the token; the result
/// only counts once GitHub's API confirms the run (right repo, unmodified workflow, success).
model CiLink {
  id           String    @id @default(cuid())
  userId       String
  /// capstone | lab
  kind         String
  /// The project id (capstone) or lesson id (lab)
  targetId     String
  /// owner/name of a public GitHub repo
  repo         String
  token        String    @unique
  /// waiting | reported | passed | failed | invalid
  status       String    @default("waiting")
  statusDetail String?
  runId        String?
  runUrl       String?
  sha          String?
  /// The latest results the workflow sent: { passed, failed, tests: [{ name, outcome, message }] }
  report       Json?
  reportedAt   DateTime?
  checkedAt    DateTime?
  verifiedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetId])
  @@map("ci_links")
}
