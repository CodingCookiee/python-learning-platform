// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  LEARNER
  AUTHOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  progress      Progress[]
  achievements  UserAchievement[]
  streak        Streak?

  xp            Int       @default(0)
  level         Int       @default(1)
  role          Role      @default(LEARNER)

  exerciseSubmissions ExerciseSubmission[]
  projectSubmissions  ProjectSubmission[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// A course, e.g. Python (kyu grades) or AI Automation (dan grades). Synced from content/.
model Track {
  id         String    @id @default(cuid())
  slug       String    @unique
  title      String
  summary    String
  /// "kyu" or "dan": how modules in this track map to grades
  grade      String
  order      Int       @unique
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  modules Module[]

  @@map("tracks")
}

model Module {
  id          String    @id @default(cuid())
  /// Stable identity from content/ (null only for pre-content legacy rows)
  slug        String?   @unique
  trackId     String?
  title       String
  summary     String    @default("")
  description String
  outcomes    String[]  @default([])
  phase       String
  /// Position within the track
  order       Int
  duration    Int
  /// Set when the module disappears from content/; learner history stays
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  track       Track?    @relation(fields: [trackId], references: [id])
  lessons     Lesson[]
  projects    Project[]

  prerequisites Module[] @relation("ModulePrerequisites")
  dependents    Module[] @relation("ModulePrerequisites")

  @@unique([trackId, order])
  @@map("modules")
}

model Lesson {
  id            String   @id @default(cuid())
  slug          String?  @unique
  archivedAt    DateTime?
  moduleId      String
  title         String
  description   String
  content       String   @db.Text
  order         Int
  estimatedTime Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  module        Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  exercises     Exercise[]
  progress      Progress[]

  @@unique([moduleId, order])
  @@map("lessons")
}

model Exercise {
  id            String   @id @default(cuid())
  slug          String?  @unique
  lessonId      String
  title         String
  description   String
  /// The prompt, in markdown
  instructions  String   @db.Text
  starterCode   String   @db.Text
  solution      String   @db.Text
  /// JSON [{ name, hidden }]: the test list shown before the first run
  testCases     String   @db.Text
  /// The drill's plp tests.py source
  tests         String   @db.Text @default("")
  /// function | program | predict | fix | refactor
  type          String   @default("function")
  hints         String   @db.Text
  /// warm-up | core | stretch
  difficulty    String
  tags          String[] @default([])
  packages      String[] @default([])
  timeoutMs     Int      @default(5000)
  /// Required drills gate lesson completion; optional ones are extra practice
  required      Boolean  @default(true)
  archivedAt    DateTime?
  order         Int
  xpReward      Int      @default(25)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lesson        Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions   ExerciseSubmission[]

  @@unique([lessonId, order])
  @@map("exercises")
}

model Project {
  id              String   @id @default(cuid())
  slug            String?  @unique
  archivedAt      DateTime?
  moduleId        String
  title           String
  summary         String   @default("")
  /// The brief, in markdown
  description     String
  requirements    String   @db.Text
  successCriteria String   @db.Text
  starterTemplate String?  @db.Text
  estimatedTime   Int
  xpReward        Int      @default(100)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  module          Module              @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  submissions     ProjectSubmission[]

  @@map("projects")
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@map("progress")
}

model ExerciseSubmission {
  id          String   @id @default(cuid())
  userId      String
  exerciseId  String
  code        String   @db.Text
  passed      Boolean
  testResults String   @db.Text
  hintsUsed   Int      @default(0)
  attempts    Int      @default(1)
  submittedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([userId, exerciseId])
  @@map("exercise_submissions")
}

model ProjectSubmission {
  id          String   @id @default(cuid())
  userId      String
  projectId   String
  files       String   @db.Text
  status      String
  feedback    String?  @db.Text
  submittedAt DateTime @default(now())
  evaluatedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId, projectId])
  @@map("project_submissions")
}

model Achievement {
  id          String   @id @default(cuid())
  slug        String?  @unique
  archivedAt  DateTime?
  order       Int      @default(0)
  name        String   @unique
  description String
  icon        String
  category    String
  criteria    String   @db.Text
  xpReward    Int      @default(0)
  tier        String
  createdAt   DateTime @default(now())

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model Streak {
  id               String   @id @default(cuid())
  userId           String   @unique
  currentStreak    Int      @default(0)
  longestStreak    Int      @default(0)
  lastActivityDate DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streaks")
}
