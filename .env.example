# Copy to .env.local and fill in. Never commit real values.
# See docs/ARCHITECTURE.md §11 for what each variable is for.

# ── Core (required) ─────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_BOOTSTRAP_EMAIL=

# ── OAuth (optional) ────────────────────────────────────────────
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Cache / rate limits / quotas (recommended) ─────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AI features (learners bring their own keys) ────────────────
# Encrypts learners' stored API keys. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Learners choose their provider and model in Settings; the platform holds no AI key

# ── Code execution ─────────────────────────────────────────────
# Keep client: drills are graded in the learner's browser. server would re-run each drill's tests in
# Node Pyodide, inside the web server, where learner code could read these secrets (security report
# C-2); production refuses to start with it. Safe server grading comes with the v2 sandbox.
GRADING_MODE=client
# Server grading only: worker threads per instance, and where Pyodide packages are cached
# (defaults: 1, and .cache/pyodide locally or /tmp/pyodide on Vercel)
GRADING_POOL_SIZE=
PLP_CACHE_DIR=
# Runs a grading thread serves before a fresh one replaces it (default 500), so no interpreter grows forever
PLP_MAX_JOBS=

# ── Labs, email, uploads ───────────────────────────────────────
# Not used yet: lab hooks rely on their 144-bit URL token
LAB_SIGNING_SECRET=
# Optional: any GitHub personal access token (no scopes needed). Without it, checking learners'
# GitHub Actions runs is limited to 60 GitHub API requests an hour per server IP; with it, 5,000.
GITHUB_TOKEN=
# Email verification and password reset. Without one of these, sign-ups are auto-verified.
# Gmail (free, ~500/day): turn on 2-step verification, then myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Or Resend (resend.com), sending from a domain you've verified there
RESEND_API_KEY=
# Optional with Gmail (defaults to "pylearn <GMAIL_USER>"); required with Resend
EMAIL_FROM=
# Optional: the address the privacy page gives for questions and data requests
CONTACT_EMAIL=
# Optional: "off" skips the breached-password check (Have I Been Pwned's range API; only the first
# five characters of a hash of the password are sent). It's skipped in tests and lets passwords
# through if the service is down.
PASSWORD_BREACH_CHECK=

# ── Local test builds only ─────────────────────────────────────
# A production build for tests can go to its own folder, so it never overwrites a running `next dev`:
#   NEXT_DIST_DIR=.next-e2e AUTH_URL=http://localhost:3010 npm run build
# Leave unset everywhere else.
# NEXT_DIST_DIR=
