# Copy to .env.local and fill in. Never commit real values.
# See docs/ARCHITECTURE.md §11 for what each variable is for.

# ── Core (required) ─────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_BOOTSTRAP_EMAIL=

# ── OAuth (optional) ────────────────────────────────────────────
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Cache / rate limits / quotas (recommended) ─────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AI features (learners bring their own keys) ────────────────
# Encrypts learners' stored API keys. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
AI_TUTOR_MODEL=claude-opus-5
AI_REVIEW_MODEL=claude-opus-5
AI_FAST_MODEL=claude-opus-5
# Optional: platform key for a free trial (leave empty for pure BYOK)
ANTHROPIC_API_KEY=

# ── Code execution ─────────────────────────────────────────────
# client = trust browser results (solo); server = re-run hidden tests on Vercel
GRADING_MODE=client

# ── Labs, email, uploads ───────────────────────────────────────
LAB_SIGNING_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
BLOB_READ_WRITE_TOKEN=

# ── Optional observability & Web3 ──────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=
ALCHEMY_API_KEY=
