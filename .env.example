# Copy to .env.local and fill in. Never commit real values.
# See docs/ARCHITECTURE.md §11 for what each variable is for.

# ── Core (required) ─────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_BOOTSTRAP_EMAIL=

# ── OAuth (optional) ────────────────────────────────────────────
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Cache / rate limits / quotas (recommended) ─────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AI features & Track 2 ──────────────────────────────────────
ANTHROPIC_API_KEY=
AI_TUTOR_MODEL=claude-opus-5
AI_REVIEW_MODEL=claude-opus-5
AI_FAST_MODEL=claude-opus-5
AI_USER_DAILY_BUDGET_USD=0.50
AI_MONTHLY_BUDGET_USD=25
VOYAGE_API_KEY=

# ── Code execution ─────────────────────────────────────────────
GRADING_MODE=client
E2B_API_KEY=
CODE_EXECUTION_API_URL=
CODE_EXECUTION_API_KEY=

# ── Labs, email, uploads ───────────────────────────────────────
LAB_SIGNING_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
BLOB_READ_WRITE_TOKEN=

# ── Optional observability & Web3 ──────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=
ALCHEMY_API_KEY=
