# Copy to .env.local and fill in. Never commit real values.
# See docs/ARCHITECTURE.md §11 for what each variable is for.

# ── Core (required) ─────────────────────────────────────────────
DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_BOOTSTRAP_EMAIL=

# ── OAuth (optional) ────────────────────────────────────────────
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Cache / rate limits / quotas (recommended) ─────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── AI features (learners bring their own keys) ────────────────
# Encrypts learners' stored API keys. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Learners choose their provider and model in Settings; there is no platform default to set
# Optional: platform key for a free trial (leave empty for pure BYOK)
ANTHROPIC_API_KEY=

# ── Code execution ─────────────────────────────────────────────
# client = trust browser results (solo); server = re-run each drill's tests in Node Pyodide on submit
GRADING_MODE=client
# Server grading only: worker threads per instance, and where Pyodide packages are cached
# (defaults: 1, and .cache/pyodide locally or /tmp/pyodide on Vercel)
GRADING_POOL_SIZE=
PLP_CACHE_DIR=

# ── Labs, email, uploads ───────────────────────────────────────
LAB_SIGNING_SECRET=
# Email verification and password reset. Without one of these, sign-ups are auto-verified.
# Gmail (free, ~500/day): turn on 2-step verification, then myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Or Resend (resend.com), sending from a domain you've verified there
RESEND_API_KEY=
# Optional with Gmail (defaults to "pylearn <GMAIL_USER>"); required with Resend
EMAIL_FROM=
# Not used: capstone uploads are stored in the database (up to 4 MB); bigger projects link GitHub
BLOB_READ_WRITE_TOKEN=

# ── Optional observability ─────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
SENTRY_DSN=
