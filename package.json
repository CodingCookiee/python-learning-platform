{
  "name": "python-learning-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/check-malware-signatures.mjs && next dev",
    "prebuild": "node -e \"require('fs').rmSync('.next/dev/types/validator.ts',{force:true})\"",
    "build": "node scripts/check-malware-signatures.mjs && next build",
    "check:malware": "node scripts/check-malware-signatures.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:backfill-achievements": "tsx scripts/backfill-achievements.ts",
    "db:studio": "prisma studio",
    "content:validate": "tsx scripts/content/validate.ts",
    "content:sync": "tsx scripts/content/sync.ts",
    "content:try": "node scripts/content/try-drill.mjs",
    "content:acceptance": "tsx scripts/content/acceptance.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:python": "vitest run --project python",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "vitest run"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@hookform/resolvers": "^5.4.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "^7.8.0",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "botid": "1.5.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.17.0",
    "next": "16.3.8",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "nodemailer": "10.0.15",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.78.0",
    "react-markdown": "^9.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "lint-staged": "^17.0.7",
    "pg": "^8.21.0",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "pyodide": "^314.0.7",
    "shadcn": "4.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "playwright-core": "1.63.0",
    "nodemailer": "$nodemailer"
  }
}
